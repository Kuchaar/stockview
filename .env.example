# Klient (Vite wstrzykuje je do bundla — to są klucze publiczne)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Tylko dla scripts/import-financials.mjs (npm run import-financials), odpalanego
# RĘCZNIE z laptopa raz na kwartał — patrz docs/SETUP.md, sekcja „Import sprawozdań".
# service_role omija RLS, więc NIGDY nie trafia do bundla, do repo ani na CI:
# żaden workflow go nie używa. Żyje wyłącznie w .env.local na komputerze.
# Bez przedrostka VITE_ — Vite wkleja każdą zmienną VITE_* do publicznego bundla.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
