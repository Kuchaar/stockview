# Klient (Vite wstrzykuje je do bundla — to są klucze publiczne)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Tylko dla scripts/import-financials.mjs (npm run import-financials).
# service_role omija RLS, więc NIGDY nie trafia do bundla ani do repo —
# lokalnie w .env.local, na CI w sekretach repozytorium.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
